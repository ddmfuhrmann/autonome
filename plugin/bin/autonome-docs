#!/usr/bin/env python3
"""Rewrite the living doc of a feature, or the system overview, from the code and the memory.

  autonome-docs --feature <slug>      # one feature
  autonome-docs --overview            # the system overview, from the feature docs
"""

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from autonome import common, docs  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(prog="autonome-docs")
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--feature")
    group.add_argument("--overview", action="store_true")
    parser.add_argument("--project")
    args = parser.parse_args()
    cwd = os.getcwd()
    project = args.project or common.project_slug(cwd)
    common.WAIT_S = float(os.getenv("AUTONOME_CONTEXT_WAIT_S", "300"))
    try:
        if args.overview:
            print(f"overview: document #{docs.update_overview(project, cwd)}")
        else:
            print(f"{args.feature}: document #{docs.update_feature(project, args.feature, cwd)}")
    except (OSError, RuntimeError) as e:  # one line for the runner's log, not a traceback
        print(f"autonome-docs: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
