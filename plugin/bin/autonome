#!/usr/bin/env bash
# The runner. Builds the runner on first use, and again when any of its sources changed.
set -euo pipefail
runner="$(cd "$(dirname "$0")/../runner" && pwd)"
built="$runner/dist/index.js"
if [ ! -f "$built" ] \
  || [ -n "$(find "$runner/src" -newer "$built" -print -quit)" ] \
  || [ "$runner/package.json" -nt "$built" ] \
  || [ "$runner/pnpm-lock.yaml" -nt "$built" ]; then
  (cd "$runner" && pnpm install --silent --frozen-lockfile && pnpm --silent build) >&2
fi
exec node "$built" "$@"
