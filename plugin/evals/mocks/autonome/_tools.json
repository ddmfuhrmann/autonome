{
  "tools": [
    {
      "name": "handoff_put",
      "description": "Store the handoff of a finished unit of work and index it for search.",
      "inputSchema": {
        "properties": {
          "handoff": {
            "$ref": "#/$defs/Handoff"
          }
        },
        "required": [
          "handoff"
        ],
        "type": "object",
        "$defs": {
          "Decision": {
            "description": "A choice the plan and the task did not already make: an alternative weighed, an ambiguity\nresolved. Restating the spec is not a decision.",
            "properties": {
              "title": {
                "title": "Title",
                "type": "string"
              },
              "rationale": {
                "title": "Rationale",
                "type": "string"
              },
              "deviation": {
                "default": false,
                "description": "true when the choice departs from the plan or a convention; only these wait for the human's review",
                "title": "Deviation",
                "type": "boolean"
              }
            },
            "required": [
              "title",
              "rationale"
            ],
            "title": "Decision",
            "type": "object"
          },
          "GateResult": {
            "properties": {
              "name": {
                "title": "Name",
                "type": "string"
              },
              "passed": {
                "title": "Passed",
                "type": "boolean"
              },
              "encores": {
                "default": 0,
                "title": "Encores",
                "type": "integer"
              },
              "root_cause": {
                "default": "",
                "title": "Root Cause",
                "type": "string"
              }
            },
            "required": [
              "name",
              "passed"
            ],
            "title": "GateResult",
            "type": "object"
          },
          "Handoff": {
            "description": "What one unit of work left behind. Written by an agent other than the one that did the work.",
            "properties": {
              "project": {
                "title": "Project",
                "type": "string"
              },
              "session_id": {
                "title": "Session Id",
                "type": "string"
              },
              "feature": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "kebab-case slug, e.g. credit-inquiry",
                "title": "Feature"
              },
              "layers": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Layers",
                "type": "array"
              },
              "summary": {
                "title": "Summary",
                "type": "string"
              },
              "plan_adherence": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/PlanItem"
                },
                "title": "Plan Adherence",
                "type": "array"
              },
              "gates": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/GateResult"
                },
                "title": "Gates",
                "type": "array"
              },
              "deviations": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Deviations",
                "type": "array"
              },
              "decisions": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/Decision"
                },
                "title": "Decisions",
                "type": "array"
              },
              "friction": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Friction",
                "type": "array"
              },
              "adherence_score": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Adherence Score"
              },
              "commit_sha": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Commit Sha"
              }
            },
            "required": [
              "project",
              "session_id",
              "summary"
            ],
            "title": "Handoff",
            "type": "object"
          },
          "PlanItem": {
            "properties": {
              "item": {
                "title": "Item",
                "type": "string"
              },
              "status": {
                "enum": [
                  "done",
                  "partial",
                  "skipped",
                  "changed"
                ],
                "title": "Status",
                "type": "string"
              },
              "note": {
                "default": "",
                "title": "Note",
                "type": "string"
              }
            },
            "required": [
              "item",
              "status"
            ],
            "title": "PlanItem",
            "type": "object"
          }
        },
        "title": "handoff_putArguments"
      }
    },
    {
      "name": "search",
      "description": "Search the project's memory. Returns the best chunk of each matching document.",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "Natural language or exact terms, e.g. class names",
            "title": "Query",
            "type": "string"
          },
          "project": {
            "description": "Project slug",
            "title": "Project",
            "type": "string"
          },
          "feature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Feature"
          },
          "layer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Layer"
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "plan, task, handoff, decision, convention, ...",
            "title": "Type"
          },
          "mode": {
            "default": "vector",
            "description": "vector (default) finds paraphrases and Portuguese questions over English text; fts for exact names",
            "enum": [
              "hybrid",
              "vector",
              "fts"
            ],
            "title": "Mode",
            "type": "string"
          },
          "k": {
            "default": 8,
            "title": "K",
            "type": "integer"
          }
        },
        "required": [
          "query",
          "project"
        ],
        "type": "object",
        "title": "searchArguments"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Result",
            "type": "array"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "title": "searchOutput"
      }
    },
    {
      "name": "gate_config_get",
      "description": "The project's current gate configuration: which gates run, in which order, encore and budget.",
      "inputSchema": {
        "properties": {
          "project": {
            "description": "Project slug",
            "title": "Project",
            "type": "string"
          }
        },
        "required": [
          "project"
        ],
        "type": "object",
        "title": "gate_config_getArguments"
      }
    },
    {
      "name": "plan_draft",
      "description": "Save a draft plan for the human to approve in the UI. Agents cannot approve plans. Put the gates\nthe plan needs and the gate config lacks in `plan.gates`: approving the plan adds them.",
      "inputSchema": {
        "$defs": {
          "DesignChoice": {
            "description": "A choice of approach or pattern the plan makes up front, so the implementers do not make it.",
            "properties": {
              "topic": {
                "description": "what is being decided, e.g. 'data access'",
                "title": "Topic",
                "type": "string"
              },
              "options": {
                "description": "the options weighed, the chosen one included",
                "items": {
                  "$ref": "#/$defs/DesignOption"
                },
                "minItems": 2,
                "title": "Options",
                "type": "array"
              },
              "chosen": {
                "description": "the name of the chosen option",
                "title": "Chosen",
                "type": "string"
              },
              "why": {
                "description": "why this one, for this project now",
                "title": "Why",
                "type": "string"
              }
            },
            "required": [
              "topic",
              "options",
              "chosen",
              "why"
            ],
            "title": "DesignChoice",
            "type": "object"
          },
          "DesignOption": {
            "properties": {
              "name": {
                "description": "short, e.g. 'repository per aggregate'",
                "title": "Name",
                "type": "string"
              },
              "tradeoffs": {
                "description": "what it costs and what it buys, in one or two lines",
                "title": "Tradeoffs",
                "type": "string"
              }
            },
            "required": [
              "name",
              "tradeoffs"
            ],
            "title": "DesignOption",
            "type": "object"
          },
          "PlanBody": {
            "properties": {
              "title": {
                "title": "Title",
                "type": "string"
              },
              "goal": {
                "description": "one or two sentences: what changes, and for whom",
                "title": "Goal",
                "type": "string"
              },
              "context": {
                "default": "",
                "description": "Markdown, laid out to be scanned: short sections under bold labels, lists over paragraphs",
                "title": "Context",
                "type": "string"
              },
              "scope": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Scope",
                "type": "array"
              },
              "out_of_scope": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Out Of Scope",
                "type": "array"
              },
              "acceptance": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Acceptance",
                "type": "array"
              },
              "risks": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Risks",
                "type": "array"
              },
              "tasks": {
                "items": {
                  "$ref": "#/$defs/TaskSpec"
                },
                "title": "Tasks",
                "type": "array"
              },
              "gates": {
                "default": [],
                "description": "gates this plan needs that the project's gate config lacks; approving the plan adds them",
                "items": {
                  "$ref": "#/$defs/ProposedGate"
                },
                "title": "Gates",
                "type": "array"
              },
              "conventions": {
                "default": [],
                "description": "rules for layers the project has none (or nothing relevant) for; approving the plan makes them active, before its tasks play",
                "items": {
                  "$ref": "#/$defs/ProposedConvention"
                },
                "title": "Conventions",
                "type": "array"
              },
              "design": {
                "default": [],
                "description": "choices of approach or pattern the plan makes, each with the options weighed; the tasks follow the chosen option, and going another way is a deviation",
                "items": {
                  "$ref": "#/$defs/DesignChoice"
                },
                "title": "Design",
                "type": "array"
              },
              "discussion": {
                "default": [],
                "description": "the questions and answers that shaped the plan",
                "items": {
                  "$ref": "#/$defs/Turn"
                },
                "title": "Discussion",
                "type": "array"
              },
              "backlog_items": {
                "default": [],
                "description": "ids of the backlog items this plan delivers (e.g. w2-ledger); approving the plan marks them doing, finishing it marks them done, abandoning it puts them back to next",
                "items": {
                  "type": "string"
                },
                "title": "Backlog Items",
                "type": "array"
              }
            },
            "required": [
              "title",
              "goal",
              "tasks"
            ],
            "title": "PlanBody",
            "type": "object"
          },
          "ProposedConvention": {
            "properties": {
              "title": {
                "title": "Title",
                "type": "string"
              },
              "rule": {
                "description": "short and checkable, e.g. 'every API response uses a response model'",
                "title": "Rule",
                "type": "string"
              },
              "why": {
                "default": "",
                "title": "Why",
                "type": "string"
              },
              "layers": {
                "default": [],
                "description": "the layers it applies to; empty for all",
                "items": {
                  "type": "string"
                },
                "title": "Layers",
                "type": "array"
              }
            },
            "required": [
              "title",
              "rule"
            ],
            "title": "ProposedConvention",
            "type": "object"
          },
          "ProposedGate": {
            "properties": {
              "name": {
                "title": "Name",
                "type": "string"
              },
              "run": {
                "description": "shell command, run from the repo root",
                "title": "Run",
                "type": "string"
              },
              "mode": {
                "default": "block",
                "enum": [
                  "fix",
                  "block"
                ],
                "title": "Mode",
                "type": "string"
              },
              "fast": {
                "default": false,
                "description": "part of the inner loop the implementer runs while working",
                "title": "Fast",
                "type": "boolean"
              },
              "when": {
                "default": [],
                "description": "path globs; the gate runs only if a changed file matches",
                "items": {
                  "type": "string"
                },
                "title": "When",
                "type": "array"
              },
              "timeout_s": {
                "default": 900,
                "title": "Timeout S",
                "type": "integer"
              },
              "with_task": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "1-based position of the task that sets this gate up; the gate joins the gate config when that task is merged. Omit if the tooling already exists.",
                "title": "With Task"
              }
            },
            "required": [
              "name",
              "run"
            ],
            "title": "ProposedGate",
            "type": "object"
          },
          "TaskSpec": {
            "properties": {
              "title": {
                "title": "Title",
                "type": "string"
              },
              "spec": {
                "description": "what to do, concretely enough to be done without asking. Markdown, laid out to be scanned, never one paragraph: a line on what changes, then **Where** (files, endpoints, entities, as a list) and **How** (the steps, as a list)",
                "title": "Spec",
                "type": "string"
              },
              "layers": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Layers",
                "type": "array"
              },
              "acceptance": {
                "default": [],
                "description": "verifiable criteria, ideally checked by gates",
                "items": {
                  "type": "string"
                },
                "title": "Acceptance",
                "type": "array"
              },
              "depends_on": {
                "default": [],
                "description": "1-based positions of earlier tasks in this plan",
                "items": {
                  "type": "integer"
                },
                "title": "Depends On",
                "type": "array"
              }
            },
            "required": [
              "title",
              "spec"
            ],
            "title": "TaskSpec",
            "type": "object"
          },
          "Turn": {
            "properties": {
              "role": {
                "title": "Role",
                "type": "string"
              },
              "text": {
                "title": "Text",
                "type": "string"
              }
            },
            "required": [
              "role",
              "text"
            ],
            "title": "Turn",
            "type": "object"
          }
        },
        "properties": {
          "project": {
            "title": "Project",
            "type": "string"
          },
          "plan": {
            "$ref": "#/$defs/PlanBody"
          },
          "feature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "kebab-case feature slug",
            "title": "Feature"
          },
          "layers": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Layers",
            "type": "array"
          },
          "plan_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "revise this draft instead of creating a new one",
            "title": "Plan Id"
          }
        },
        "required": [
          "project",
          "plan"
        ],
        "title": "plan_draftArguments",
        "type": "object"
      }
    },
    {
      "name": "wave_draft",
      "description": "Group draft plans of several features into a wave the human approves at once in the UI. Each\nfeature's plan is drafted first with plan_draft. Approved waves play in order; a feature that\ndepends on others is checked against the code (rehearsed) before it plays.",
      "inputSchema": {
        "properties": {
          "project": {
            "title": "Project",
            "type": "string"
          },
          "wave": {
            "$ref": "#/$defs/WaveBody"
          },
          "wave_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "revise this draft instead of creating a new one",
            "title": "Wave Id"
          }
        },
        "required": [
          "project",
          "wave"
        ],
        "type": "object",
        "$defs": {
          "Turn": {
            "properties": {
              "role": {
                "title": "Role",
                "type": "string"
              },
              "text": {
                "title": "Text",
                "type": "string"
              }
            },
            "required": [
              "role",
              "text"
            ],
            "title": "Turn",
            "type": "object"
          },
          "WaveBody": {
            "properties": {
              "title": {
                "title": "Title",
                "type": "string"
              },
              "goal": {
                "title": "Goal",
                "type": "string"
              },
              "out_of_scope": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Out Of Scope",
                "type": "array"
              },
              "features": {
                "description": "in the order they should be played",
                "items": {
                  "$ref": "#/$defs/WaveFeature"
                },
                "title": "Features",
                "type": "array"
              },
              "discussion": {
                "default": [],
                "description": "the questions and answers that shaped the wave",
                "items": {
                  "$ref": "#/$defs/Turn"
                },
                "title": "Discussion",
                "type": "array"
              }
            },
            "required": [
              "title",
              "goal",
              "features"
            ],
            "title": "WaveBody",
            "type": "object"
          },
          "WaveFeature": {
            "properties": {
              "plan_id": {
                "description": "a draft plan of this project",
                "title": "Plan Id",
                "type": "integer"
              },
              "depends_on": {
                "default": [],
                "description": "1-based positions of earlier features in this wave",
                "items": {
                  "type": "integer"
                },
                "title": "Depends On",
                "type": "array"
              }
            },
            "required": [
              "plan_id"
            ],
            "title": "WaveFeature",
            "type": "object"
          }
        },
        "title": "wave_draftArguments"
      }
    },
    {
      "name": "plan_approve",
      "description": "Ask the human, right in their session, to approve a draft plan. The question and a summary of\nthe stored plan go to the person through their client (MCP elicitation); the agent cannot answer\nit. If they decline, or the client cannot ask, the plan stays a draft for the UI.",
      "inputSchema": {
        "properties": {
          "project": {
            "title": "Project",
            "type": "string"
          },
          "plan_id": {
            "title": "Plan Id",
            "type": "integer"
          }
        },
        "required": [
          "project",
          "plan_id"
        ],
        "type": "object",
        "title": "plan_approveArguments"
      }
    },
    {
      "name": "wave_approve",
      "description": "Ask the human, right in their session, to approve a draft wave and every plan in it, the same\nway as plan_approve.",
      "inputSchema": {
        "properties": {
          "project": {
            "title": "Project",
            "type": "string"
          },
          "wave_id": {
            "title": "Wave Id",
            "type": "integer"
          }
        },
        "required": [
          "project",
          "wave_id"
        ],
        "type": "object",
        "title": "wave_approveArguments"
      }
    },
    {
      "name": "history_get",
      "description": "What went off plan before on the same subject (the feature and the closest related ones): plan\nitems changed or skipped, deviations, decisions taken against the plan and how the human judged them,\nrehearsal revisions, reviewer blocks, fixes from soundcheck, playback and rejected decisions, blocked\ntasks and friction. Read it before planning, and turn each pattern into acceptance, out of scope, a\nconvention or a question.",
      "inputSchema": {
        "properties": {
          "project": {
            "title": "Project",
            "type": "string"
          },
          "subject": {
            "description": "What is being planned, in plain words",
            "title": "Subject",
            "type": "string"
          },
          "feature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The feature slug, if known",
            "title": "Feature"
          }
        },
        "required": [
          "project",
          "subject"
        ],
        "type": "object",
        "title": "history_getArguments"
      }
    },
    {
      "name": "backlog_list",
      "description": "The backlog by wave (the roadmap's waves): each wave's title and status, and its items with id,\ntitle, status (backlog, next, doing, done), note and prd.",
      "inputSchema": {
        "properties": {
          "project": {
            "title": "Project",
            "type": "string"
          },
          "wave": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "only this wave",
            "title": "Wave"
          }
        },
        "required": [
          "project"
        ],
        "type": "object",
        "title": "backlog_listArguments"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Result",
            "type": "array"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "title": "backlog_listOutput"
      }
    },
    {
      "name": "backlog_item_update",
      "description": "Change a backlog item, or move it to another wave. Use it to record what a planning conversation\ndecided (an item moved, left out, its note). Every change is kept with who and when.",
      "inputSchema": {
        "properties": {
          "project": {
            "title": "Project",
            "type": "string"
          },
          "item_id": {
            "description": "the item's id, e.g. w1-ci",
            "title": "Item Id",
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "backlog, next, doing or done",
            "title": "Status"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Note"
          },
          "prd": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
